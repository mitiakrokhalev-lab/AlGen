{
  "id": "top",
  "имя": "топологические пространства",
  "заметка": "Третий раздел. Устроен так же, как группы и модули, но модель у него другая: КОНЕЧНОЕ топологическое пространство — это в точности предпорядок (открытые множества суть множества, замкнутые вниз по специализации), и потому все конечные пространства до пяти точек перечисляются целиком, а не берутся по рецептам. Бесконечные — ℝ, ℚ, Зоргенфрей, канторово множество — объявляются рукой, как и бесконечные группы.",
  "заметка_о_вырождении": "У конечных пространств половина свойств схлопывается: T₁ равносильно дискретности, метризуемость тоже, вторая аксиома счётности верна всегда. Это НЕ недостаток модели, а свойство предмета — и счётчик слепых пятен обязан про это говорить вслух, иначе «подтверждено на 300 примерах» будет значить «проверено на пространствах, где вопрос тривиален».",
  "sorts": {
    "Top.obj": { "имя": "пространство", "буквы": ["X", "Y", "Z", "W"], "введение": "%s — топологическое пространство" },
    "Top.sub": { "имя": "подпространство", "буквы": ["A", "B", "C", "D"], "введение": "%s ⊆ %a" },
    "Top.mor": { "имя": "непрерывное отображение", "буквы": ["f", "g", "h"], "введение": "%s : %d → %c" }
  },
  "subsorts": [
    ["Top.sub", "Top.obj"]
  ],
  "properties": [
    {
      "id": "point",
      "sort": "Top.obj",
      "имя": "одноточечно",
      "фраза": "%s одноточечно",
      "отрицание": "%s не одноточечно"
    },
    { "id": "finite", "sort": "Top.obj", "имя": "конечно", "фраза": "%s конечно", "отрицание": "%s бесконечно" },
    { "id": "countable", "sort": "Top.obj", "имя": "счётно", "фраза": "%s счётно", "отрицание": "%s несчётно" },
    {
      "id": "T0",
      "sort": "Top.obj",
      "имя": "T₀",
      "фраза": "%s удовлетворяет T₀",
      "отрицание": "%s не удовлетворяет T₀"
    },
    {
      "id": "T1",
      "sort": "Top.obj",
      "имя": "T₁",
      "фраза": "%s удовлетворяет T₁",
      "отрицание": "%s не удовлетворяет T₁"
    },
    {
      "id": "T2",
      "sort": "Top.obj",
      "имя": "хаусдорфово",
      "фраза": "%s хаусдорфово",
      "отрицание": "%s не хаусдорфово"
    },
    {
      "id": "T3",
      "sort": "Top.obj",
      "имя": "регулярно",
      "фраза": "%s регулярно",
      "отрицание": "%s не регулярно",
      "заметка": "Регулярность здесь понимается вместе с T₁ (то есть T₃), иначе правило «регулярно ⇒ хаусдорфово» было бы ложным."
    },
    {
      "id": "T4",
      "sort": "Top.obj",
      "имя": "нормально",
      "фраза": "%s нормально",
      "отрицание": "%s не нормально",
      "заметка": "Нормальность тоже вместе с T₁ (T₄)."
    },
    { "id": "connected", "sort": "Top.obj", "имя": "связно", "фраза": "%s связно", "отрицание": "%s несвязно" },
    {
      "id": "path-connected",
      "sort": "Top.obj",
      "имя": "линейно связно",
      "фраза": "%s линейно связно",
      "отрицание": "%s не линейно связно"
    },
    {
      "id": "totally-disconnected",
      "sort": "Top.obj",
      "имя": "вполне несвязно",
      "фраза": "%s вполне несвязно",
      "отрицание": "%s не вполне несвязно"
    },
    {
      "id": "compact",
      "sort": "Top.obj",
      "имя": "компактно",
      "фраза": "%s компактно",
      "отрицание": "%s не компактно"
    },
    {
      "id": "locally-compact",
      "sort": "Top.obj",
      "имя": "локально компактно",
      "фраза": "%s локально компактно",
      "отрицание": "%s не локально компактно"
    },
    {
      "id": "discrete",
      "sort": "Top.obj",
      "имя": "дискретно",
      "фраза": "%s дискретно",
      "отрицание": "%s не дискретно"
    },
    {
      "id": "indiscrete",
      "sort": "Top.obj",
      "имя": "антидискретно",
      "фраза": "%s антидискретно",
      "отрицание": "%s не антидискретно"
    },
    {
      "id": "metrizable",
      "sort": "Top.obj",
      "имя": "метризуемо",
      "фраза": "%s метризуемо",
      "отрицание": "%s не метризуемо"
    },
    {
      "id": "first-countable",
      "sort": "Top.obj",
      "имя": "первая аксиома счётности",
      "фраза": "%s удовлетворяет первой аксиоме счётности",
      "отрицание": "%s не удовлетворяет первой аксиоме счётности"
    },
    {
      "id": "second-countable",
      "sort": "Top.obj",
      "имя": "вторая аксиома счётности",
      "фраза": "%s удовлетворяет второй аксиоме счётности",
      "отрицание": "%s не удовлетворяет второй аксиоме счётности"
    },
    {
      "id": "separable",
      "sort": "Top.obj",
      "имя": "сепарабельно",
      "фраза": "%s сепарабельно",
      "отрицание": "%s не сепарабельно"
    },
    {
      "id": "open",
      "sort": "Top.sub",
      "имя": "открыто",
      "фраза": "%s открыто в %a",
      "отрицание": "%s не открыто в %a"
    },
    {
      "id": "closed",
      "sort": "Top.sub",
      "имя": "замкнуто",
      "фраза": "%s замкнуто в %a",
      "отрицание": "%s не замкнуто в %a"
    },
    {
      "id": "dense",
      "sort": "Top.sub",
      "имя": "плотно",
      "фраза": "%s плотно в %a",
      "отрицание": "%s не плотно в %a"
    },
    {
      "id": "whole",
      "sort": "Top.sub",
      "имя": "всё",
      "фраза": "%s совпадает с %a",
      "отрицание": "%s отлично от %a"
    },
    {
      "id": "injective",
      "sort": "Top.mor",
      "имя": "инъективно",
      "фраза": "%s инъективно",
      "отрицание": "%s не инъективно"
    },
    {
      "id": "surjective",
      "sort": "Top.mor",
      "имя": "сюръективно",
      "фраза": "%s сюръективно",
      "отрицание": "%s не сюръективно"
    },
    {
      "id": "homeo",
      "sort": "Top.mor",
      "имя": "гомеоморфизм",
      "фраза": "%s — гомеоморфизм",
      "отрицание": "%s не гомеоморфизм"
    },
    {
      "id": "constant",
      "sort": "Top.mor",
      "имя": "постоянно",
      "фраза": "%s постоянно",
      "отрицание": "%s не постоянно"
    }
  ],
  "relations": [
    {
      "id": "homeomorphic",
      "имя": "гомеоморфны",
      "in": ["Top.obj", "Top.obj"],
      "symmetric": true,
      "формула": "%1 ≈ %2",
      "фраза": "%1 гомеоморфно %2",
      "отрицание": "%1 не гомеоморфно %2",
      "перенос": true,
      "заметка_о_переносе": "Изоморфизм переносит все свойства, объявленные на том же сорте: это не теорема предметной области, а смысл слова «свойство объекта». Правила генерируются в src/deduce.js (`переносПоОтношению`), по одному на свойство и на сторону."
    },
    {
      "id": "le",
      "имя": "содержится в",
      "in": ["Top.sub", "Top.sub"],
      "same": "ambient",
      "формула": "%1 ⊆ %2",
      "фраза": "%1 содержится в %2",
      "отрицание": "%1 не содержится в %2"
    }
  ],
  "constructions": [
    {
      "id": "choose-space",
      "имя": "пространство со свойствами",
      "choice": true,
      "in": [],
      "out": "Top.obj",
      "фраза": "возьмём пространство"
    },
    {
      "id": "choose-sub",
      "имя": "подпространство со свойствами",
      "choice": true,
      "in": [
        { "role": "X", "sort": "Top.obj" }
      ],
      "out": { "sort": "Top.sub", "ambient": "X" },
      "фраза": "выберем подпространство %X"
    },
    {
      "id": "choose-map",
      "имя": "непрерывное отображение со свойствами",
      "choice": true,
      "in": [
        { "role": "X", "sort": "Top.obj" },
        { "role": "Y", "sort": "Top.obj" }
      ],
      "out": { "sort": "Top.mor", "dom": "X", "cod": "Y" },
      "фраза": "выберем непрерывное отображение %X → %Y"
    },
    {
      "id": "whole-sub",
      "имя": "всё пространство как подпространство",
      "prec": 100,
      "in": [
        { "role": "X", "sort": "Top.obj" }
      ],
      "out": { "sort": "Top.sub", "ambient": "X" },
      "формула": "%X",
      "фраза": "всё %X",
      "gives": { "whole": true, "open": true, "closed": true, "dense": true }
    },
    {
      "id": "closure",
      "имя": "замыкание",
      "prec": 90,
      "in": [
        { "role": "X", "sort": "Top.obj" },
        { "role": "A", "sort": "Top.sub", "ambient": "X" }
      ],
      "out": { "sort": "Top.sub", "ambient": "X" },
      "формула": "cl %A",
      "фраза": "замыкание %A",
      "gives": { "closed": true },
      "авто": true,
      "preserves": [
        { "p": "connected", "ссылка": "замыкание связного множества связно" },
        { "p": "separable", "ссылка": "плотное счётное подмножество остаётся плотным в замыкании" }
      ],
      "заметка_о_сохранении": "Связность замыкания — классическая теорема: если cl A = U ⊔ V с открытыми в cl A непустыми U, V, то A пересекается с обоими (точки замыкания прилипают), и A распалось бы. Сепарабельность уже была отдельным правилом; здесь она записана тем же сокращением."
    },
    {
      "id": "interior",
      "имя": "внутренность",
      "prec": 90,
      "in": [
        { "role": "X", "sort": "Top.obj" },
        { "role": "A", "sort": "Top.sub", "ambient": "X" }
      ],
      "out": { "sort": "Top.sub", "ambient": "X" },
      "формула": "int %A",
      "фраза": "внутренность %A",
      "gives": { "open": true },
      "авто": true
    },
    {
      "id": "prod-top",
      "имя": "произведение",
      "prec": 60,
      "commutative": true,
      "in": [
        { "role": "X", "sort": "Top.obj" },
        { "role": "Y", "sort": "Top.obj" }
      ],
      "out": "Top.obj",
      "формула": "%X × %Y",
      "фраза": "произведение %X и %Y",
      "preserves": [
        "T0", "T1", "T2", "T3", "connected", "path-connected", "compact", "metrizable", "first-countable",
        "second-countable", "separable", "totally-disconnected", "discrete", "indiscrete", "finite", "countable",
        "locally-compact"
      ],
      "заметка": "Нормальность НЕ переносится — плоскость Зоргенфрея. Это одна из главных задач темы, и правила про неё тут нет намеренно.",
      "reflects": [
        "point", "finite", "countable", "T0", "T1", "T2", "T3", "connected", "path-connected",
        "totally-disconnected", "compact", "locally-compact", "discrete", "indiscrete", "metrizable",
        "first-countable", "second-countable", "separable"
      ],
      "заметка_об_отражении": "Нормальности в списке нет с обеих сторон: плоскость Зоргенфрея не нормальна при нормальных сомножителях, а наследственной нормальность не бывает."
    },
    {
      "id": "sum-top",
      "имя": "дизъюнктная сумма",
      "prec": 55,
      "commutative": true,
      "in": [
        { "role": "X", "sort": "Top.obj" },
        { "role": "Y", "sort": "Top.obj" }
      ],
      "out": "Top.obj",
      "формула": "%X ⊔ %Y",
      "фраза": "дизъюнктная сумма %X и %Y",
      "preserves": [
        "T0", "T1", "T2", "T3", "T4", "metrizable", "discrete", "first-countable", "second-countable", "separable",
        "totally-disconnected", "compact", "locally-compact", "finite", "countable"
      ],
      "заметка": "Связность НЕ переносится: сумма двух непустых всегда несвязна.",
      "reflects": [
        "finite", "countable", "T0", "T1", "T2", "T3", "T4", "totally-disconnected", "compact", "locally-compact",
        "discrete", "metrizable", "first-countable", "second-countable", "separable"
      ]
    },
    {
      "id": "collapse",
      "имя": "фактор по подпространству",
      "prec": 70,
      "in": [
        { "role": "X", "sort": "Top.obj" },
        { "role": "A", "sort": "Top.sub", "ambient": "X" }
      ],
      "out": "Top.obj",
      "формула": "%X/%A",
      "фраза": "фактор %X по %A",
      "preserves": ["connected", "path-connected", "compact", "separable", "finite", "countable"],
      "авто": true,
      "заметка": "Хаусдорфовость НЕ переносится, и это главный пример темы: фактор отрезка по плотному подмножеству антидискретен."
    },
    {
      "id": "im-top",
      "имя": "образ",
      "prec": 90,
      "in": [
        { "role": "F", "sort": "Top.mor" }
      ],
      "out": { "sort": "Top.sub", "ambient": "cod F" },
      "формула": "im %F",
      "фраза": "образ %F",
      "авто": true
    }
  ],
  "degenerations": [
    {
      "op": "collapse",
      "when": {
        "A": { "point": true }
      },
      "equals": "X",
      "почему": "фактор по точке ничего не меняет"
    },
    {
      "op": "closure",
      "when": {
        "A": { "closed": true }
      },
      "equals": "A",
      "почему": "замыкание замкнутого — оно само"
    },
    {
      "op": "interior",
      "when": {
        "A": { "open": true }
      },
      "equals": "A",
      "почему": "внутренность открытого — оно само"
    },
    {
      "op": "closure",
      "when": {
        "A": { "dense": true }
      },
      "equals": { "op": "whole-sub", "args": ["X"] },
      "почему": "замыкание плотного — всё пространство"
    },
    {
      "op": "im-top",
      "when": {
        "F": { "surjective": true }
      },
      "equals": { "op": "whole-sub", "args": ["cod F"] },
      "почему": "образ сюръекции — всё пространство"
    },
    {
      "op": "prod-top",
      "when": {
        "Y": { "point": true }
      },
      "equals": "X",
      "почему": "X × точка ≈ X"
    },
    {
      "op": "prod-top",
      "when": {
        "X": { "point": true }
      },
      "equals": "Y",
      "почему": "точка × Y ≈ Y"
    }
  ],
  "rules": [
    {
      "id": "T₂⇒T₁",
      "scene": { "X": "Top.obj" },
      "if": [
        { "p": "T2", "t": "X" }
      ],
      "then": { "p": "T1", "t": "X" }
    },
    {
      "id": "T₁⇒T₀",
      "scene": { "X": "Top.obj" },
      "if": [
        { "p": "T1", "t": "X" }
      ],
      "then": { "p": "T0", "t": "X" }
    },
    {
      "id": "T₃⇒T₂",
      "scene": { "X": "Top.obj" },
      "if": [
        { "p": "T3", "t": "X" }
      ],
      "then": { "p": "T2", "t": "X" }
    },
    {
      "id": "T₄⇒T₃",
      "scene": { "X": "Top.obj" },
      "if": [
        { "p": "T4", "t": "X" }
      ],
      "then": { "p": "T3", "t": "X" }
    },
    {
      "id": "метризуемо⇒нормально",
      "scene": { "X": "Top.obj" },
      "if": [
        { "p": "metrizable", "t": "X" }
      ],
      "then": { "p": "T4", "t": "X" }
    },
    {
      "id": "метризуемо⇒первая аксиома",
      "scene": { "X": "Top.obj" },
      "if": [
        { "p": "metrizable", "t": "X" }
      ],
      "then": { "p": "first-countable", "t": "X" }
    },
    {
      "id": "вторая аксиома⇒первая",
      "scene": { "X": "Top.obj" },
      "if": [
        { "p": "second-countable", "t": "X" }
      ],
      "then": { "p": "first-countable", "t": "X" }
    },
    {
      "id": "вторая аксиома⇒сепарабельно",
      "scene": { "X": "Top.obj" },
      "if": [
        { "p": "second-countable", "t": "X" }
      ],
      "then": { "p": "separable", "t": "X" }
    },
    {
      "id": "метризуемо и сепарабельно⇒вторая аксиома",
      "scene": { "X": "Top.obj" },
      "if": [
        { "p": "metrizable", "t": "X" },
        { "p": "separable", "t": "X" }
      ],
      "then": { "p": "second-countable", "t": "X" },
      "заметка": "Для метрических пространств сепарабельность, вторая аксиома счётности и линделёфовость равносильны."
    },
    {
      "id": "дискретно⇒метризуемо",
      "scene": { "X": "Top.obj" },
      "if": [
        { "p": "discrete", "t": "X" }
      ],
      "then": { "p": "metrizable", "t": "X" }
    },
    {
      "id": "дискретно⇒вполне несвязно",
      "scene": { "X": "Top.obj" },
      "if": [
        { "p": "discrete", "t": "X" }
      ],
      "then": { "p": "totally-disconnected", "t": "X" }
    },
    {
      "id": "дискретно⇒локально компактно",
      "scene": { "X": "Top.obj" },
      "if": [
        { "p": "discrete", "t": "X" }
      ],
      "then": { "p": "locally-compact", "t": "X" }
    },
    {
      "id": "счётно и дискретно⇒вторая аксиома",
      "scene": { "X": "Top.obj" },
      "if": [
        { "p": "countable", "t": "X" },
        { "p": "discrete", "t": "X" }
      ],
      "then": { "p": "second-countable", "t": "X" }
    },
    {
      "id": "одноточечно⇒компактно",
      "scene": { "X": "Top.obj" },
      "if": [
        { "p": "point", "t": "X" }
      ],
      "then": { "p": "compact", "t": "X" }
    },
    {
      "id": "одноточечно⇒метризуемо",
      "scene": { "X": "Top.obj" },
      "if": [
        { "p": "point", "t": "X" }
      ],
      "then": { "p": "metrizable", "t": "X" }
    },
    {
      "id": "одноточечно⇒связно",
      "scene": { "X": "Top.obj" },
      "if": [
        { "p": "point", "t": "X" }
      ],
      "then": { "p": "connected", "t": "X" }
    },
    {
      "id": "одноточечно⇒линейно связно",
      "scene": { "X": "Top.obj" },
      "if": [
        { "p": "point", "t": "X" }
